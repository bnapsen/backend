# AP Advantage Player realtime backend
HOST=0.0.0.0
PORT=8081
DATA_DIR=./data

# Local development can leave these blank. Production should set the Firebase
# project used by the AP account system so ScrapRunner rewards land on accounts.
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_GOOGLE_AUTH_ENABLED=true
NOVA_AUTH_REQUIRED=true

# SIM wallet and ScrapRunner persistence collections.
SIM_WALLET_FIRESTORE_COLLECTION=simWallets
SIM_STARTING_BALANCE=1000
SCRAPRUNNER_PROFILE_COLLECTION=scraprunnerProfiles
SCRAPRUNNER_RUN_COLLECTION=scraprunnerRuns

# Existing backend features. Leave blank unless those pages are being used.
CLIP_ADMIN_TOKEN=
KALSHI_LAB_TOKEN=
KALSHI_TRADE_TOKEN=
DATABASE_URL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=
WAGNERS_TIMECARD_ADMIN_EMAILS=
WAGNERS_TIMECARD_EMAIL_TO=
WAGNERS_TIMECARD_EMAIL_FROM=
